# FastAPI Python 백엔드 환경변수 예시 파일 (.env.example)
# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 값을 채우세요.
# .env 파일은 .gitignore에 의해 Git에 올라가지 않습니다.
# 실제 RDS 자격증명은 슬랙 DM으로 별도 전달받으세요.
# ============================================================

# ── AWS RDS MySQL (외부 인프라, 컨테이너에 박지 않음) ────────────────────────
# 팀이 공유하는 RDS 인스턴스. 자격증명은 슬랙 DM 으로 받아서 채워넣을 것.
DB_HOST=your-rds-endpoint.ap-northeast-2.rds.amazonaws.com
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=capston
DB_PORT=13306

# Express → FastAPI 내부 호출 인증 키
# [추가 2026-05-10]
# 이유: FastAPI는 공개 API가 아니라 Express 뒤의 내부 데이터 계층이므로,
#      Express를 거치지 않은 직접 호출을 차단하기 위해 공유 키를 검사합니다.
# 설명: src/backend/.env 의 INTERNAL_API_KEY 와 반드시 같은 긴 랜덤 문자열로 맞추세요.
INTERNAL_API_KEY=replace-with-a-long-random-shared-secret

# ── DB 커넥션 풀 / 성능 측정 ────────────────────────────────────────────────
# [추가 2026-05-10]
# 이유: 요청마다 MySQL 연결을 새로 만들지 않고 재사용하여 RDS 연결 생성 비용을 줄입니다.
# 설명: SLOW_QUERY_MS 이상 걸린 SQL과 SLOW_REQUEST_MS 이상 걸린 FastAPI 요청만 로그로 남깁니다.
DB_POOL_SIZE=8
DB_POOL_MAX_OVERFLOW=4
SLOW_QUERY_MS=200
SLOW_REQUEST_MS=500
