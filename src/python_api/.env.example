# ============================================================
# FastAPI Python 백엔드 환경변수 예시 파일 (.env.example)
# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 값을 채우세요.
# .env 파일은 .gitignore에 의해 Git에 올라가지 않습니다.
# 실제 RDS 자격증명은 슬랙 DM으로 별도 전달받으세요.
# ============================================================

# ── AWS RDS MySQL (외부 인프라 — 컨테이너에 박지 않음) ────────────────────────
# 팀이 공유하는 RDS 인스턴스. 자격증명은 슬랙 DM 으로 받아서 채워넣을 것.

DB_HOST=your-rds-endpoint.ap-northeast-2.rds.amazonaws.com
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=capston
DB_PORT=3306
