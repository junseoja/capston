# ============================================================
# .dockerignore (FastAPI Python 빌드 컨텍스트용)
# ============================================================
# context: ./src/python_api
# ============================================================

# Python 가상환경 — 컨테이너 안에서 pip install
venv
.venv

# 컴파일 캐시
__pycache__
*.pyc
*.pyo

# 환경변수 — env_file 로 런타임 주입
.env
.env.*
!.env.example

# 로그
*.log

# IDE / OS 메타
.vscode
.DS_Store
