# ============================================================
# Express 백엔드 환경변수 예시 파일 (.env.example)
# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 값을 채우세요.
# .env 파일은 .gitignore에 의해 Git에 올라가지 않습니다.
# ============================================================

# Express 서버 포트 (기본값: 3000)
PORT=3000

# FastAPI 서버 URL (기본값: http://localhost:8000)
PYTHON_API=http://localhost:8000

# React 프론트엔드 URL - CORS 허용 대상 (기본값: http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# ── AWS S3 (피드 이미지 업로드 저장소) ───────────────────────────────────────
# 2026-05-05 도입: 기존 src/backend/uploads/ 로컬 저장 → S3 객체 저장으로 전환
# 팀원 간 RDS 공유 시 "내 PC 이미지가 다른 팀원 PC에서 깨지는" 문제 해결.
# 자격증명은 IAM 사용자 routine-mate-s3-uploader 의 키
# (s3:PutObject + s3:DeleteObject 권한만 가진 최소 권한 사용자).

AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
