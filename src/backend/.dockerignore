# ============================================================
# .dockerignore (Express 백엔드 빌드 컨텍스트용)
# ============================================================
# context: ./src/backend
# 이 컨텍스트 안에서 이미지로 안 들어갈 파일 목록.
# ============================================================

# 의존성 — 컨테이너 안에서 npm install
node_modules

# 환경변수 — env_file 로 런타임에 주입
.env
.env.*
!.env.example

# 옛날 로컬 업로드 폴더 — S3 전환으로 더 이상 사용 안 함
uploads/*
!uploads/.gitkeep

# 로그
*.log
npm-debug.log*

# IDE / OS 메타
.vscode
.DS_Store
