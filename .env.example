# ============================================================
# 프론트엔드 환경변수 예시 파일 (.env.example)
# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 값을 채우세요.
# .env 파일은 .gitignore에 의해 Git에 올라가지 않습니다.
# ============================================================

# Express 백엔드 서버 URL
#   로컬:  http://localhost:3000
#   배포:  https://<배포된-백엔드-도메인>   (예: https://routine-mate-api.onrender.com)
#
# [배포 안내 2026-05-17]
#   Vercel 등에 프론트 배포 시, 이 값을 .env 가 아니라
#   배포 플랫폼의 "Environment Variables" 에 VITE_EXPRESS_URL 로 등록.
#   (Vite 는 빌드 시점에 VITE_ 변수를 코드에 박으므로 빌드 환경에 있어야 함)
VITE_EXPRESS_URL=http://localhost:3000
##VITE_EXPRESS_URL=https://api.routimate.com # 배포 시 실제 API URL로 변경