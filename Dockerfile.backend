# ============================================================
# Routine Mate — Backend (Express) 컨테이너
# ============================================================
# 베이스 이미지: node:20-alpine
#
# 컨테이너 안 동작:
#   1. /app 작업 디렉터리
#   2. package*.json 만 먼저 복사 → npm install (캐싱)
#   3. 코드는 docker-compose volume 으로 호스트 동기화
#   4. [수정 2026-05-17] nodemon --legacy-watch(polling) 으로 시작
#      - 이유: macOS/Windows 도커 볼륨은 inotify 파일 이벤트가 경계를 못 넘어
#        node --watch 가 호스트 코드 변경을 감지 못 함 → 핫리로드 사실상 죽음
#        → 매번 재빌드하게 되던 문제. nodemon 의 legacy-watch(polling) 로 해결.
#      - 로컬 직접 실행(start.sh)은 네이티브라 node --watch 로 충분 (package.json dev)
#
# 빌드 컨텍스트: ./src/backend
#   - docker-compose.yml 에서 context: ./src/backend 로 지정
#   - 따라서 COPY 경로는 src/backend 디렉터리 기준 (즉 package.json 직접 참조)
# ============================================================

FROM node:20-alpine

WORKDIR /app

# 의존성 파일만 먼저 복사
COPY package.json package-lock.json ./

# 의존성 설치 (@aws-sdk/client-s3, multer-s3 포함)
RUN npm install

# Express 서버 포트
EXPOSE 3000

# Express 서버 시작 — nodemon legacy-watch(polling) 로 도커 볼륨 변경 감지
# package.json 의 dev:docker 스크립트 = nodemon --legacy-watch --watch . --ext js,json app.js
CMD ["npm", "run", "dev:docker"]
